{
  "name": "UninoVet",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "dockerDashComposeVersion": "v2"
    },
    "ghcr.io/devcontainers/features/node:1": {}
  },
  "forwardPorts": [3000, 5000, 8080],
  "portsAttributes": {
    "3000": { "label": "UninoVet - porta única (app / + clínica /clinica/ + /api)", "onAutoForward": "openBrowser" },
    "5000": { "label": "UninoVet - app do cliente (Flutter, direto)", "onAutoForward": "silent" },
    "8080": { "label": "UninoVet - aplicação da clínica (Java, direto)", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter",
        "anthropic.claude-code"
      ]
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y make && (npm install -g @anthropic-ai/claude-code || true)",
  "postAttachCommand": "echo 'Rode:  make up   e abra a porta 3000 na aba PORTS. Veja tudo com: make help'"
}
